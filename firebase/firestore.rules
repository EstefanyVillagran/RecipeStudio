rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function tienePerfil() { return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function esAdmin() { return tienePerfil() && perfil().rol == 'admin'; }
    function esStaff() { return tienePerfil() && perfil().rol in ['admin', 'agente']; }

    // Perfiles de admin/agente: cada uno solo lee el suyo. Se crean a mano desde la consola.
    match /usuarios/{uid} {
      // cada quien lee su perfil; el admin puede listarlos para elegir a qué agente asignar un caso
      allow read: if signedIn() && (request.auth.uid == uid || esAdmin());
      // al entrar, cada quien guarda SOLO su correo y un nombre corto; el rol nunca se cambia desde la app
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['correo', 'nombre'])
        && request.resource.data.correo == request.auth.token.email.lower();
      allow create, delete: if false;
    }

    match /reportes/{id} {
      // Celular (anónimo vinculado por QR) o staff: crear solo reportes propios y válidos.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['titulo', 'descripcion', 'categoria', 'prioridad', 'estado', 'dispositivo', 'ownerUid', 'asignadoA', 'creadoEn'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 3 && request.resource.data.titulo.size() <= 80
        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() >= 5 && request.resource.data.descripcion.size() <= 500
        && request.resource.data.prioridad in ['Baja', 'Media', 'Alta']
        && request.resource.data.estado == 'Nuevo'
        && request.resource.data.asignadoA == null;

      // Cada celular lee solo lo suyo; admin y agente leen todo.
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || esStaff());

      // Staff cambia estado; solo el admin asigna. Nadie edita título, dueño ni contenido.
      allow update: if esStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'asignadoA', 'notas'])
        && (esAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['asignadoA']))
        && request.resource.data.estado in ['Nuevo', 'En proceso', 'Resuelto']
        && (!('notas' in request.resource.data) || request.resource.data.notas.size() <= 50);

      allow delete: if esAdmin();
    }

    // Recetas terminadas de cada celular (foto final comprimida + ingredientes). Solo el dueño.
    match /progreso/{uid}/recetas/{rid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'hecha', 'completados', 'actualizadoEn', 'fotoB64', 'fotoKey', 'notas'])
        && (!('fotoB64' in request.resource.data) || request.resource.data.fotoB64.size() < 250000)
        && (!('notas' in request.resource.data) || request.resource.data.notas.size() <= 600);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Recetas creadas por cada usuario (solo el dueño las ve y las edita).
    match /recetasPropias/{uid}/items/{rid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'categoria', 'tiempo', 'dificultad', 'porciones', 'chefTip', 'pasos', 'ingredientes', 'creadoEn'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 1 && request.resource.data.nombre.size() <= 60
        && request.resource.data.ingredientes is list && request.resource.data.ingredientes.size() >= 1 && request.resource.data.ingredientes.size() <= 40
        && request.resource.data.pasos is list && request.resource.data.pasos.size() <= 15;
    }

    // Muro de recetas: lo ve cualquiera con la app; cada quien publica y borra solo lo suyo. La foto completa está en S3.
    match /muro/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && id.matches(request.auth.uid + '_.*')
        && request.resource.data.keys().hasOnly(['receta', 'autor', 'key', 'thumbB64', 'creadoEn', 'ownerUid'])
        && request.resource.data.receta is string && request.resource.data.receta.size() <= 80
        && request.resource.data.autor is string && request.resource.data.autor.size() <= 40
        && request.resource.data.thumbB64.size() < 150000
        && (request.resource.data.key == '' || request.resource.data.key.matches('fotos/[0-9]{8}/[a-f0-9]{24}\\.(jpg|png|webp)'));
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || esAdmin());
    }

    // Todo lo demás, cerrado.
    match /{document=**} { allow read, write: if false; }
  }
}
